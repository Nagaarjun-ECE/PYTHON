def calculate_business_outcome():
    try:
        line1 = sys.stdin.readline()
        if not line1:
            return
        t = int(line1.strip())
    except ValueError:
        return

    for _ in range(t):
        try:
            n = int(sys.stdin.readline().strip())    
            p1, p2, p3 = map(int, sys.stdin.readline().split())
            total_revenue = n * 50
            total_expense_percentage = p1 + p2 + p3
            outcome = total_revenue * (100 - total_expense_percentage) // 100
            if outcome >= 0:
                print(f"Profit: {outcome}")
            else:
                print(f"Loss: {abs(outcome)}")
        except (ValueError, TypeError):
            break
